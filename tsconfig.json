{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"moduleDetection": "force",
		"verbatimModuleSyntax": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"types": ["bun"],
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true
	},
	"include": ["src"],
	"exclude": ["src/__tests__"]
}
